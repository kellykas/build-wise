  "about": {
    "badge": "25+ years in business",
    "title": "A construction company built on trust, craft and discipline.",
    "subtitle": "Scer-L/Construct Sarl is a full-service general contractor delivering commercial, residential, industrial and infrastructure projects across the region. We're family-founded, employee-owned, and proudly hands-on.",
    "see_work": "See our work",
    "talk_team": "Talk to our team",
    "story_title": "Our story",
    "story_p1": "Founded in 1998 by Marcus Reyes with a single pickup truck and a four-person framing crew, Scer-L/Construct Sarl has grown into a multi-disciplinary general contractor, but the values haven't changed.",
    "story_p2": "We still believe construction is a craft. We hire and train master tradespeople, run our own self-perform teams, and treat every site like it has our name on it, because it does.",
    "story_p3": "Today, our 600+ employees deliver projects ranging from custom homes to airports, with the same belief that built our first project: do it right, do it safely, and do it on time.",
    "values_title": "What we stand for",
    "v_safety": "Safety first",
    "v_safety_d": "Zero-harm culture with daily toolbox talks and OSHA-leading incident rates.",
    "v_trust": "Built on trust",
    "v_trust_d": "Transparent pricing, weekly reporting and no surprises at closeout.",
    "v_quality": "Craft & quality",
    "v_quality_d": "Master tradespeople and a dedicated QA/QC team on every site.",
    "v_green": "Sustainable building",
    "v_green_d": "LEED-accredited team and a default low-waste site programme.",
    "milestones_title": "Milestones",
    "m_1998": "Founded as a 4-person residential framing crew.",
    "m_2006": "Completed our first commercial high-rise build.",
    "m_2014": "Expanded into infrastructure with the Coastal interchange.",
    "m_2020": "Launched our in-house design-build studio.",
    "m_2025": "500+ projects delivered across 9 regions.",
    "leadership_title": "Leadership",
    "l_marcus": "Founder & CEO",
    "l_elena": "Chief Operating Officer",
    "l_daniel": "VP Pre-Construction",
    "l_priya": "Director, Safety & Quality",
    "employee_owned": "Employee-owned",
    "employee_owned_d": "Since 2018, every employee with one year of tenure receives ownership in the company. Our crews aren't just working on your project, they own the outcome.",
